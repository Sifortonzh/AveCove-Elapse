# 公网域名，例如 quiz.example.com
DOMAIN=localhost
NEXT_PUBLIC_SITE_URL=https://quiz.example.com

# PostgreSQL（请替换为随机强密码）
POSTGRES_DB=hongdou
POSTGRES_USER=hongdou
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 学号匿名化、会话签名、配置加密与管理入口（均至少 32 个随机字符）
SYNC_SECRET=replace-with-at-least-32-random-characters
CONFIG_ENCRYPTION_KEY=replace-with-a-third-independent-random-secret
ADMIN_KEY=replace-with-another-long-random-admin-key

# 全站公共 AI 可选；管理员从 /admin/ai 配置。普通用户可在 /custom-ai 保存自己的 Key，不需要这些环境变量
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=20

# 邮箱验证码；公网启用邮箱登录时必须配置。域名邮箱请填写服务商提供的 SMTP 参数
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@foxmail.com
SMTP_PASS=replace-with-qq-mail-smtp-authorization-code
SMTP_FROM=红豆生南国 <your-account@foxmail.com>

# 数据库参数
DB_POOL_SIZE=10
DATABASE_SSL=false
PORT=3000

# 可选异地备份目标，例如 rclone 已配置的 remote:hongdou
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=14
