# API and worker must share these settings. Never use the Elapse SMTP/AI credentials implicitly.
FORGE_API_TOKEN=replace-with-a-long-random-token
FORGE_STORAGE_ROOT=forge/.data
# Empty uses local SQLite. Production: separate database/role on existing PostgreSQL instance.
FORGE_DATABASE_URL=
FORGE_CURRICULUM_DIR=forge/curriculums
FORGE_OCR_PROVIDER=mineru
FORGE_MINERU_MODE=native
FORGE_MINERU_COMMAND=mineru
FORGE_MINERU_BACKEND=pipeline
# remote: installed MinerU 3.x CLI forwards to an operator-managed MinerU service.
FORGE_MINERU_API_URL=
# docker: explicitly pinned operator-provided image, not assumed to support MPS.
FORGE_MINERU_IMAGE=
FORGE_PARSER=rules
# Optional, explicit opt-in. Phase 1 AI requests limited to <=3 PDF pages.
FORGE_AI_BASE_URL=
FORGE_AI_API_KEY=
FORGE_AI_MODEL=
